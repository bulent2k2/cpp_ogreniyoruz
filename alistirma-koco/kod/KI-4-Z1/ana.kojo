// KI-4-Z1 · En kötü durum
// Çıktı: "100: en çok 7 adım" biçiminde üç satır
tanım adımSayısı(tutulan: Sayı, sınır: Sayı): Sayı = {
  den altSınır = 1
  den üstSınır = sınır
  den adım = 0
  // KI-4-A1'in döngüsü, yazdırmadan
  adım
}
satıryaz(s"100: en çok ${(1 |-| 100).işle(t => adımSayısı(t, 100)).enİrisi} adım")
