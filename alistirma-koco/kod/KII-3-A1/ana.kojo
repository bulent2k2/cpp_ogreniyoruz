// KII-3-A1 · Sesli harfler
// Çıktı: "kelebek kanadi: 6 sesli" ve "programlama dili: 6 sesli"
dez sesliler = "aeıioöuü".kümeye
tanım sesliSayısı(yazı: Yazı): Sayı = 0
satıryaz(s"kelebek kanadi: ${sesliSayısı("kelebek kanadi")} sesli")
satıryaz(s"programlama dili: ${sesliSayısı("programlama dili")} sesli")
