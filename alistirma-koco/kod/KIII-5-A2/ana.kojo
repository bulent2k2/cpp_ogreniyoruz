// KIII-5-A2 · Harf sayacını sınayın
// Çıktı: "denemeler geçti." sonra "harf: sayı" satırları (alfabetik)
tanım harfSay(yazı: Yazı) = {
  dez harfler = yazı.ele(h => h != ' ')
  // öbekle, işle, dizine, sıralı
  Dizin[(Harf, Sayı)]()
}
// belirt: harfSay("aab") == Dizin(('a', 2), ('b', 1)); harfSay("") == Boş
satıryaz("denemeler geçti.")
// harfSay("kelebek kanadi") satır satır
